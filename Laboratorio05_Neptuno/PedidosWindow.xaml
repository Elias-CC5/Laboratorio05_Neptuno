<Window x:Class="Laboratorio05_Neptuno.PedidosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedidos y Reportes" Height="450" Width="700">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Reporte de Pedidos por Fechas" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Label Content="Inicio:"/>
                <DatePicker x:Name="dpInicio" Width="120" Margin="5,0"/>
                <Label Content="Fin:"/>
                <DatePicker x:Name="dpFin" Width="120" Margin="5,0"/>
                <Button x:Name="btnBuscar" Content="Generar Reporte" Width="110" Margin="10,0" Click="btnBuscar_Click"/>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="dgReporte" Grid.Row="1" AutoGenerateColumns="True"/>
    </Grid>
</Window>